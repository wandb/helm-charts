# Source: operator/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    control-plane: controller-manager
  name: wandb-controller-manager
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      control-plane: controller-manager
  template:
    metadata:
      annotations: {}
      labels:
        control-plane: controller-manager
    spec:
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      imagePullSecrets:
      containers:
      - name: manager
        command:
        - /manager
        args:
        - --leader-elect
        - --zap-devel=false
        - --isolation-namespaces=tenant-a,tenant-b,default
        image: wandb/controller:latest
        imagePullPolicy: "Always"
        env:
        - name: WANDB_MANAGER_SERVICE_ACCOUNT
          value: operator-v1
        - name: OPERATOR_NAMESPACE
          value: default
        - name: SERVICE_ACCOUNT_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.serviceAccountName
        - name: AIRGAPPED
          value: "false"
        livenessProbe:
          httpGet:
            path: /healthz
            port: 8081
          initialDelaySeconds: 15
          periodSeconds: 20
        readinessProbe:
          httpGet:
            path: /readyz
            port: 8081
          initialDelaySeconds: 5
          periodSeconds: 10
        resources:
          limits:
            cpu: 1000m
            memory: 2Gi
          requests:
            cpu: 400m
            memory: 512Mi
        volumeMounts:
        - name: helm-cache
          mountPath: /helm
      volumes:
      - name: helm-cache
        emptyDir: {}
      - name: wandb-ca-certs
        projected:
          sources:
      serviceAccountName: operator-v1
      terminationGracePeriodSeconds: 10

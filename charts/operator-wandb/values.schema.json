{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mcp-server": {
      "type": "object",
      "properties": {
        "install": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "const": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(|sha256:[a-f0-9]{64})$"
            }
          }
        },
        "tools": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "enum": [
                "auto",
                "models-only",
                "models-weave"
              ]
            }
          }
        },
        "accessMode": {
          "type": "string",
          "enum": [
            "read-write",
            "read-only"
          ]
        },
        "traceBackend": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "disabled"
              ]
            },
            "url": {
              "type": "string"
            }
          }
        },
        "routing": {
          "type": "object",
          "properties": {
            "internalBaseUrl": {
              "type": "string"
            }
          }
        },
        "observability": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "none",
                "datadog-agent",
                "otel"
              ]
            },
            "privacy": {
              "type": "string",
              "enum": [
                "off",
                "standard",
                "strict"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        }
      }
    },
    "global": {
      "type": "object",
      "required": [
        "legacyIngress",
        "traefikIngress",
        "ipAllowList"
      ],
      "properties": {
        "legacyIngress": {
          "type": "boolean"
        },
        "traefikIngress": {
          "type": "boolean"
        },
        "ipAllowList": {
          "type": "object",
          "required": [
            "enabled",
            "systemCIDRs",
            "userCIDRs"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "systemCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "userCIDRs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "evaluations": {
      "type": "object",
      "required": [
        "install"
      ],
      "properties": {
        "install": {
          "type": "boolean"
        },
        "mysql": {
          "type": "object",
          "required": [
            "host",
            "database",
            "user",
            "port",
            "tls",
            "passwordSecret"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "database": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "tls": {
              "type": "string",
              "enum": [
                "required",
                "disabled"
              ]
            },
            "passwordSecret": {
              "type": "object",
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "clickhouse": {
          "type": "object",
          "required": [
            "host",
            "database",
            "user",
            "nativePort",
            "tls",
            "passwordSecret"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "database": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "nativePort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "tls": {
              "type": "string",
              "enum": [
                "required"
              ]
            },
            "passwordSecret": {
              "type": "object",
              "required": [
                "name",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "const": false
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "useWeaveTraceIdentity": {
              "const": false
            }
          }
        },
        "migration": {
          "type": "object",
          "properties": {
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "backoffLimit": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "install": {
                "const": true
              }
            },
            "required": [
              "install"
            ]
          },
          "then": {
            "properties": {
              "mysql": {
                "properties": {
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "user": {
                    "type": "string",
                    "minLength": 1
                  },
                  "database": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passwordSecret": {
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "clickhouse": {
                "properties": {
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "user": {
                    "type": "string",
                    "minLength": 1
                  },
                  "database": {
                    "type": "string",
                    "minLength": 1
                  },
                  "passwordSecret": {
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
